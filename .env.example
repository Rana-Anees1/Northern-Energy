# ---------------------------------------------------------------------------
# Contact form (app/api/contact/route.ts)
# Without these the form returns a 500 and the visitor is told to call instead.
# Uses the same Resend account as the procure-clone (EPC) site.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com) — SERVER ONLY, never NEXT_PUBLIC_
RESEND_API_KEY=re_your_api_key_here

# Comma-separated list of addresses that receive new enquiries
CONTACT_RECIPIENTS=Enquires@energyproconsultants.co.uk,Callum@energyproconsultants.co.uk,contactus@energyproconsultants.co.uk

# From address for the team + customer confirmation emails.
# The domain must be verified in the Resend account.
CONFIRMATION_FROM_EMAIL=no_reply@energyproconsultants.co.uk
CONFIRMATION_FROM_NAME=Northern Renewable Centre
